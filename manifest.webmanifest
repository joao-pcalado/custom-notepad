{
  "name": "Bloco — bloco de notas",
  "short_name": "Bloco",
  "description": "Bloco de notas personalizável com abas, minimap, temas e chips de link.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#1a1a2e",
  "theme_color": "#0f3460",
  "lang": "pt-BR",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ],
  "launch_handler": { "client_mode": "focus-existing" },
  "file_handlers": [
    {
      "action": "./",
      "launch_type": "single-client",
      "accept": {
        "text/plain": [".txt", ".log", ".ini", ".cfg", ".conf", ".env", ".sh", ".bat", ".ps1"],
        "text/markdown": [".md", ".markdown"],
        "text/csv": [".csv"],
        "application/json": [".json"],
        "application/xml": [".xml"],
        "application/yaml": [".yaml", ".yml"],
        "text/html": [".html", ".htm"],
        "text/css": [".css"],
        "text/javascript": [".js", ".jsx", ".ts", ".tsx"],
        "text/x-python": [".py"]
      }
    }
  ]
}
